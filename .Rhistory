# Function to scrape one department
scrape_department <- function(page, department) {
people <- page |>
html_elements("a") |>
keep(~ str_detect(html_attr(.x, "href"), "/directory/"))
names <- people |>
html_text2() |>
str_squish()
websites <- people |>
html_attr("href")
tibble(
department = department,
name = names,
website = websites
)
}
# Department names
departments <- c(
"Accountancy",
"Economics",
"Entrepreneurship",
"Finance",
"Information Systems & Analytics",
"Marketing",
"Management"
)
