knitr::opts_chunk$set(echo = TRUE)
con = DBI::dbConnect(RSQLite::SQLite(), "../data/midwest_airbnb_extended.db")
listings     = DBI::dbReadTable(con, "listings") |> tibble::as_tibble()
availability = DBI::dbReadTable(con, "availability_monthly") |> tibble::as_tibble()
reviews      = DBI::dbReadTable(con, "reviews_monthly") |> tibble::as_tibble()
DBI::dbDisconnect(con)
host_counts = listings |>
dplyr::count(host_id, name = "host_listings_count")
a1 = host_counts |>
dplyr::filter(host_listings_counts >= 10) |>
dplyr::summarise(n_hosts = dplyr::n())
host_counts = listings |>
dplyr::count(host_id, name = "host_listing_count")
a1 = host_counts |>
dplyr::filter(host_listing_counts >= 10) |>
dplyr::summarise(n_hosts = dplyr::n())
a1
a1 = host_counts |>
dplyr::filter(host_listing_count >= 10) |>
dplyr::summarise(n_hosts = dplyr::n())
a1
#a2
chicago_total = listings |>
dplyr::filter(city == "Chicago") |>
dplyr::summarise(total = dplyr::n())
chicago_large_hosts = listings |>
dplyr::left_join(host_counts, by = "host_id") |>
dplyr::filter( city == "Chicago", host_listing_count >= 10 ) |>
dplyr::summarise(listings = dplyr::n())
a2 = chicago_large_hosts$listings / chicago_total$total * 100
a2
task2 = listings |>
dplyr::filter(
room_type == "Entire home/apt",
accommodates >= 4,
number_of_reviews >= 10,
review_scores_rating >= 4.8 ) |>
dplyr::mutate( price_per_person = price / accommodates ) |>
dplyr::group_by(city, neighbourhood) |>
dplyr::summarise(
median_price_per_person = median(price_per_person, na.rm = TRUE),
n_listings = dplyr::n(),
.groups = "drop" ) |>
dplyr::filter(n_listings >= 20)
a3 = task2 |>
dplyr::filter(city == "Columbus") |>
dplyr::arrange(median_price_per_person)
a3
task3 = listings |>
dplyr::group_by(city, room_type) |>
dplyr::summarise(
dplyr::across(
c(price, reviews_per_month,
estimated_revenue_l365d),
~ median(.x, na.rm = TRUE) ),
.groups = "drop"
)
a4 = task3 |>
dplyr::filter(
city == "Twin Cities",
room_type == "Entire home/apt")
a4
task4 = listings |>
dplyr::group_by(city) |>
dplyr::arrange(
dplyr::desc(estimated_revenue_l365d),
.by_group = TRUE ) |>
dplyr::mutate(
rank = dplyr::row_number(),
top_cutoff = ceiling(0.10 * dplyr::n()) ) |>
dplyr::ungroup()
columbus_total_revenue = task4 |>
dplyr::filter(city == "Columbus") |>
dplyr::summarise(
total_revenue = sum(estimated_revenue_l365d, na.rm = TRUE))
columbus_top10_revenue = task4 |>
dplyr::filter(
city == "Columbus",
rank <= top_cutoff ) |>
dplyr::summarise(
top10_revenue = sum(estimated_revenue_l365d, na.rm = TRUE) )
a5 = columbus_top10_revenue$top10_revenue /
columbus_total_revenue$total_revenue * 100
a5
october = availability |>
dplyr::filter(month == "2026-10")
task5 = listings |>
dplyr::filter(room_type == "Entire home/apt") |>
dplyr::inner_join(october, by = "id") |>
dplyr::mutate(
mostly_taken = nights_available < 0.5 * nights_in_month ) |>
dplyr::group_by(city) |>
dplyr::summarise(
share_mostly_taken =
mean(mostly_taken,na.rm = TRUE) * 100,
n = dplyr::n(),
.groups = "drop" ) |>
dplyr::arrange(share_mostly_taken)
a6_a7 = task5 |>
dplyr::slice(1)
a6_a7
october = availability |>
dplyr::filter(month == "2026-10")
task5 = listings |>
dplyr::filter(room_type == "Entire home/apt") |>
dplyr::inner_join(october, by = "id") |>
dplyr::mutate(
mostly_taken = nights_available < 0.5 * nights_in_month ) |>
dplyr::group_by(city) |>
dplyr::summarise(
share_mostly_taken =
mean(mostly_taken,na.rm = TRUE) * 100,
n = dplyr::n(),
.groups = "drop" ) |>
dplyr::arrange(share_mostly_taken)
a6_a7 = task5 |>
dplyr::slice(1)
a6_a7
task6 = reviews |>
dplyr::inner_join(
listings |>
dplyr::select(id, city),
by = "id" ) |>
dplyr::filter(
month >= "2025-07",
month <= "2026-06" ) |>
dplyr::group_by(city, month) |>
dplyr::summarise(
total_reviews = sum(reviews, na.rm = TRUE),
.groups = "drop"
)
twin_cities_demand = task6 |>
dplyr::filter(city == "Twin Cities") |>
dplyr::arrange(dplyr::desc(total_reviews))
a8 = twin_cities_demand |>
dplyr::slice(1)
a8
busiest = twin_cities_demand |>
dplyr::summarise(max_reviews = max(total_reviews))
quietest = twin_cities_demand |>
dplyr::summarise(min_reviews = min(total_reviews))
a9 = busiest$max_reviews / quietest$min_reviews
a9
task7 = listings |>
dplyr::filter(
room_type == "Entire home/apt",
host_is_superhost %in% c("t","f")
) |>
dplyr::mutate(
superhost_group = dplyr::if_else(
host_is_superhost == "t",
"Superhost",
"Other host"
)
) |>
dplyr::group_by(city,superhost_group) |>
dplyr::summarise(
median_price = median(price, na.rm = TRUE),
median_rating = median(review_scores_rating,na.rm = TRUE),
.groups = "drop"
)
task7
task7
premiums = task7 |>
dplyr::select(city, superhost_group, median_price) |>
tidyr::pivot_wider(
names_from = superhost_group,
values_from = median_price ) |>
dplyr::mutate(
premium = Superhost - `Other host` )
# B1 numbers
premiums
Task8
