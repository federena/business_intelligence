missing_listings = dplyr::n
missing_by_city = missing_availability |>
missing_by_city
a10 = missing_availability |>
dplyr::summarise(
missing_listings = dplyr::n()
)
a10
missing_by_city = missing_availability |>
dplyr::count(city, name = "missing_listings") |>
dplyr::arrange(dplyr::desc(missing_listings))
a2_all = listings |>
dplyr::left_join(host_counts, by = "host_id") |>
dplyr::group_by(city) |>
dplyr::summarise(
share_10plus = mean(host_listing_count >= 10) * 100,
.groups = "drop"
)
a2_all
a5_all = listings |>
dplyr::group_by(city) |>
dplyr::arrange(
dplyr::desc(estimated_revenue_l365d),
.by_group = TRUE
) |>
dplyr::mutate(
top10 = dplyr::row_number() <= ceiling(0.10 * dplyr::n())
) |>
dplyr::summarise(
share_top10_revenue =
sum(estimated_revenue_l365d[top10], na.rm = TRUE) /
sum(estimated_revenue_l365d, na.rm = TRUE) * 100,
.groups = "drop"
)
a5_all
