library(rvest)
# URLs for the seven departments
urls <- c(
"https://miamioh.edu/fsb/directory/?up=/query/all/all/Accountancy/all",
"https://miamioh.edu/fsb/directory/?up=/query/all/all/Economics/all",
"https://miamioh.edu/fsb/directory/?up=/query/all/all/Entrepreneurship/all",
"https://miamioh.edu/fsb/directory/?up=/query/all/all/Finance/all",
"https://miamioh.edu/fsb/directory/?up=/query/all/all/Information%20Systems%20--%20Analytics/all",
"https://miamioh.edu/fsb/directory/?up=/query/all/all/Marketing/all",
"https://miamioh.edu/fsb/directory/?up=/query/all/all/Management/all"
)
# Read the webpages
pages <- map(urls, read_html)
# Function to scrape one department page
scrape_department <- function(page) {
rows <- page |>
html_elements("tr")
map_dfr(rows, function(row) {
cells <- row |>
html_elements("td")
# Skip rows that are not directory records
if (length(cells) < 3) {
return(NULL)
}
person_cell <- cells[[3]]
# Get the person's name
name <- person_cell |>
html_element("a") |>
html_text2()
# Get the website linked to the person's name
website <- person_cell |>
html_element("a") |>
html_attr("href")
# Get all text in the person cell
all_text <- person_cell |>
html_text2() |>
str_squish()
# Remove the person's name to leave the position
position <- all_text |>
str_remove(fixed(name)) |>
str_squish()
# Get department
department <- cells[[1]] |>
html_text2() |>
str_squish()
tibble(
department = department,
name = name,
position = position,
website = website
)
})
}
# Scrape all seven departments
fsb <- map(pages, scrape_department) |>
bind_rows()
fsb <- fsb |>
group_by(department) |>
mutate(first_department = row_number() == 1) |>
ungroup() |>
arrange(desc(first_department), department) |>
select(-first_department)
